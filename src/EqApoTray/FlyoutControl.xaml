<UserControl x:Class="EqApoTray.FlyoutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="340"
             Loaded="OnLoaded">
    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,14,16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top row: startup toggle + status indicator + browse button -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          x:Name="StartupCheck"
                          Content="开机自启动"
                          VerticalAlignment="Center"
                          Checked="StartupCheck_Toggled"
                          Unchecked="StartupCheck_Toggled" />

                <Ellipse Grid.Column="1"
                         x:Name="StatusDot"
                         Width="10" Height="10"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="Gray"
                         ToolTip="配置文件状态" />

                <ui:Button Grid.Column="2"
                           x:Name="BrowseButton"
                           Content="配置..."
                           Appearance="Secondary"
                           Click="BrowseConfig_Click" />
            </Grid>

            <!-- Slider with current value -->
            <StackPanel Grid.Row="1" Margin="0,4,0,4">
                <TextBlock x:Name="GainLabel"
                           Text="+0.0 dB"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <Slider x:Name="GainSlider"
                        Minimum="-20"
                        Maximum="20"
                        TickFrequency="0.5"
                        IsSnapToTickEnabled="True"
                        SmallChange="0.5"
                        LargeChange="2"
                        ValueChanged="GainSlider_ValueChanged" />
            </StackPanel>

            <!-- Path display -->
            <TextBlock Grid.Row="2"
                       x:Name="PathLabel"
                       Margin="0,10,0,0"
                       FontSize="11"
                       Opacity="0.65"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Grid>
    </Border>
</UserControl>
