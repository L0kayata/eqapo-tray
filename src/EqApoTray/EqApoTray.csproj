<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EqApoTray</AssemblyName>
    <RootNamespace>EqApoTray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <Version>0.1.0</Version>
    <!-- Required by [LibraryImport] source generator (it emits unsafe marshalling code; our own code stays safe). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Unpackaged WinUI 3 deployment (no MSIX). -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- The component-only WASDK reference below (no Microsoft.WindowsAppSDK.Runtime)
         has no framework-dependent mode: every build is self-contained and needs
         a RID. Default to the host's so plain `dotnet build` / F5 keep working. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Keep Debug fast; AOT only on Release. -->
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI component only (version pinned by the Microsoft.WindowsAppSDK
         2.5.1 metapackage), not the metapackage itself: that would also pull
         the AI/ML/Search/Widgets runtimes, which this app never loads. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!-- WinUI 2.3.9 asks for >= 2.1.8, which was never published (NU1603). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <!-- Core (non-WinUI) package: H.NotifyIcon.WinUI depends on the WASDK
         metapackage, which would defeat the component-only reference above. -->
    <PackageReference Include="H.NotifyIcon" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icons, generated by scripts/build_icons.py. Embedded (not loose
         files) and loaded by Services/TrayIconSwitcher.cs. -->
    <EmbeddedResource Include="Assets\TrayIcons\*.ico" LogicalName="TrayIcons.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    WinUI 3 unpackaged + Publish workaround: the SDK does not add the XAML
    compiled binaries (*.xbf) or the MRT resource index (<App>.pri) to the
    publish output. Without them Microsoft.UI.Xaml.dll throws a stowed
    exception (0xc000027b) at startup because InitializeComponent() can't
    locate App.xaml resources. This affects both AOT and non-AOT publish.
  -->
  <Target Name="_IncludeWinUIArtifactsInPublish" BeforeTargets="ComputeFilesToPublish">
    <!-- Two-pass evaluation: collect first, then attach metadata. A single
         ItemGroup with a wildcard inside Include did not expand reliably
         under `dotnet publish` for this SDK + AOT combination. -->
    <ItemGroup>
      <_WinUIXbfToPublish Include="$(IntermediateOutputPath)**\*.xbf" />
      <_WinUIPriToPublish Include="$(OutputPath)$(AssemblyName).pri" Condition="Exists('$(OutputPath)$(AssemblyName).pri')" />
    </ItemGroup>
    <Message Text="WinUI publish artifacts: xbf=@(_WinUIXbfToPublish->Count()) pri=@(_WinUIPriToPublish->Count())" Importance="high" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_WinUIXbfToPublish)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_WinUIPriToPublish)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
