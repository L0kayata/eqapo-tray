<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EqApoTray</AssemblyName>
    <RootNamespace>EqApoTray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <Version>0.1.0</Version>
    <!-- Required by [LibraryImport] source generator (it emits unsafe marshalling code; our own code stays safe). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Unpackaged WinUI 3 deployment (no MSIX). -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</WindowsAppSDKSelfContained>
    <!-- Keep Debug fast; AOT only on Release. -->
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260416003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

</Project>
